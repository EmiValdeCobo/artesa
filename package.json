{
  "name": "artesa-root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "engines": { "node": ">=22.0.0", "pnpm": ">=10.18.1" },
  "description": "artesa — ERP + POS para restaurante/cafetería",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:backend": "pnpm --filter artesa-backend dev",
    "dev:frontend": "pnpm --filter artesa-frontend dev",
    "build": "pnpm -r build",
    "db:migrate": "node scripts/db.js migrate",
    "db:seed": "node scripts/db.js seed",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "doc:ieee": "powershell -ExecutionPolicy Bypass -File docs/Documentacion_IEEE/compilar.ps1",
    "doc:ia:sync": "node docs/Documentacion_IEEE/actualizar_ia.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "pg": "^8.16.3"
  }
}
