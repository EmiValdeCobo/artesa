# Configuración de base de datos PostgreSQL (usado por Docker Compose y local)
POSTGRES_USER=CAMBIAR_USUARIO_LOCAL
POSTGRES_PASSWORD=CAMBIAR_CONTRASENA_LOCAL
POSTGRES_DB=CAMBIAR_NOMBRE_BD_LOCAL
POSTGRES_PORT=5432

# Backend API
PORT=3000
DATABASE_URL=postgres://CAMBIAR_USUARIO_LOCAL:CAMBIAR_CONTRASENA_LOCAL@localhost:5432/CAMBIAR_NOMBRE_BD_LOCAL
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173

# Frontend (Vite)
VITE_API_URL=/api
VITE_BACKEND_URL=http://localhost:3000
