# Configuración de base de datos PostgreSQL (usado por Docker Compose y local)
POSTGRES_USER=origenes
POSTGRES_PASSWORD=origenes_password_segura
POSTGRES_DB=origenes
POSTGRES_PORT=5432

# Backend API
PORT=3000
DATABASE_URL=postgres://origenes:origenes_password_segura@localhost:5432/origenes
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173

# Frontend (Vite)
VITE_API_URL=/api
VITE_BACKEND_URL=http://localhost:3000
