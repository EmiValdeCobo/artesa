# Configuración de base de datos PostgreSQL (usado por Docker Compose y local)
POSTGRES_USER=CAMBIAR_USUARIO_LOCAL
POSTGRES_PASSWORD=CAMBIAR_CONTRASENA_LOCAL
POSTGRES_DB=CAMBIAR_NOMBRE_BD_LOCAL
POSTGRES_PORT=5432

# Rol de aplicación (no uses POSTGRES_USER para el backend)
WEB_DB_USER=web_user
WEB_DB_PASSWORD=CAMBIAR_CONTRASENA_WEB_DB

PORT=3000
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
