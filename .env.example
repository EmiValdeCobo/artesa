# Configuración de base de datos PostgreSQL (usado por Docker Compose y local)
POSTGRES_USER=CAMBIAR_USUARIO_LOCAL
POSTGRES_PASSWORD=CAMBIAR_CONTRASENA_LOCAL
POSTGRES_DB=CAMBIAR_NOMBRE_BD_LOCAL
POSTGRES_PORT=5432
POSTGRES_HOST_BIND=127.0.0.1

# Rol de aplicación (no uses POSTGRES_USER para el backend)
WEB_DB_USER=web_user
WEB_DB_PASSWORD=CAMBIAR_CONTRASENA_WEB_DB

NODE_ENV=development
PORT=3000
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:8080
# Cookies de sesión: false para desarrollo local HTTP; en producción (NODE_ENV=production) se activa (true) por defecto
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
TRUST_PROXY=1
# Formato de logs de morgan ('dev' en desarrollo, 'combined' en producción)
MORGAN_FORMAT=dev
